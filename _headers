# ==============================================================================
# CLOUDFLARE PAGES - EDGE HEADERS & SECURITY DIRECTIVES
# ==============================================================================

# 1. Políticas Globales de Seguridad para todo el sitio
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), vr=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://avatars.githubusercontent.com https://raw.githubusercontent.com https://user-images.githubusercontent.com https://github-production-user-asset-6210df.s3.amazonaws.com https://github.com https://komarev.com; frame-src 'self' https://www.linkedin.com; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; upgrade-insecure-requests;

# 2. Caché para Documento Principal (HTML) - Siempre fresco con revalidación
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 3. Caché de Larga Duración para Recursos Estáticos Inmutables (Imágenes y Multimedia)
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 4. Caché de Larga Duración para Documentos y Archivos Descargables (CV)
/assets/docs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200

# 5. Caché para Hojas de Estilo CSS y Módulos JavaScript (Siempre frescos con revalidación)
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 6. Caché para Manifiesto y Metadatos de SEO
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: application/manifest+json; charset=utf-8
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8
